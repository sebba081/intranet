# Copiar como `.env` y ajustar. El archivo `.env` no se versiona.

NODE_ENV=development
PORT=3001
SESSION_SECRET=cambiar-en-produccion

# Base de datos (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu-password
DB_NAME=intranet
DB_DIALECT=mysql

# Coste del hash de contraseñas
SALT_ROUNDS=10
